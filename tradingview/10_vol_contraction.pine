//@version=5
// ============================================================================
// BTC Tournament Strategy #10 — Volatility Contraction Breakout on 4H
// ============================================================================
// Rules (matches backtest/strategies.py : strat_vol_contraction):
//   Compression = 4H ATR(14) < 0.8 * median(ATR(14), 100)
//   Long  when compressed AND close > 55-bar Donchian upper (prev)
//   Short when compressed AND close < 55-bar Donchian lower (prev)
//   Exit long  when close < 20-bar Donchian lower (prev)
//   Exit short when close > 20-bar Donchian upper (prev)
//   Stop : 3 * ATR14 (15m)
// ----------------------------------------------------------------------------
indicator("BTC Tournament #10 — Vol Contraction Breakout 4H", overlay=true)

entryLen = input.int(55, "Breakout channel")
exitLen  = input.int(20, "Exit channel")
atr4Len  = input.int(14, "4H ATR length")
compWin  = input.int(100,"Compression window")
compMult = input.float(0.8,"Compression factor")
atrLen   = input.int(14, "15m ATR length")
sMult    = input.float(3.0, "Stop = ATR *")

htf = "240"
uEntry = request.security(syminfo.tickerid, htf, ta.highest(high, entryLen)[1], lookahead=barmerge.lookahead_off)
lEntry = request.security(syminfo.tickerid, htf, ta.lowest(low,  entryLen)[1], lookahead=barmerge.lookahead_off)
uExit  = request.security(syminfo.tickerid, htf, ta.highest(high, exitLen)[1],  lookahead=barmerge.lookahead_off)
lExit  = request.security(syminfo.tickerid, htf, ta.lowest(low,  exitLen)[1],  lookahead=barmerge.lookahead_off)
a4     = request.security(syminfo.tickerid, htf, ta.atr(atr4Len),               lookahead=barmerge.lookahead_off)
a4Med  = request.security(syminfo.tickerid, htf, ta.percentile_nearest_rank(ta.atr(atr4Len), compWin, 50), lookahead=barmerge.lookahead_off)
c4     = request.security(syminfo.tickerid, htf, close,                          lookahead=barmerge.lookahead_off)
compressed = a4 < compMult * a4Med

var int pos = 0
if pos == 0
    if compressed[1] and c4 > uEntry
        pos := 1
    else if compressed[1] and c4 < lEntry
        pos := -1
else if pos == 1
    if c4 < lExit
        pos := 0
else if pos == -1
    if c4 > uExit
        pos := 0

newLong  = pos ==  1 and pos[1] !=  1
newShort = pos == -1 and pos[1] != -1
exitAll  = pos ==  0 and pos[1] != 0

a = ta.atr(atrLen)
stopDist = sMult * a

plot(uEntry, "Donchian 55 Upper (4H)", color=color.green, linewidth=1)
plot(lEntry, "Donchian 55 Lower (4H)", color=color.red,   linewidth=1)
bgcolor(compressed ? color.new(color.yellow, 85) : na)

plotshape(newLong,  "LONG",  shape.labelup,   location.belowbar, color.green, text="L", textcolor=color.white, size=size.small)
plotshape(newShort, "SHORT", shape.labeldown, location.abovebar, color.red,   text="S", textcolor=color.white, size=size.small)
plotshape(exitAll,  "EXIT",  shape.xcross,    location.absolute, color.orange, size=size.tiny)

alertcondition(newLong,  "BTC #10 VolContract LONG",  "LONG: compressed + 55-high break")
alertcondition(newShort, "BTC #10 VolContract SHORT", "SHORT: compressed + 55-low break")

var table info = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Strategy",    text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(info, 1, 0, "#10 VolContraction 4H", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(info, 0, 1, "Compressed", text_color=color.white)
    table.cell(info, 1, 1, compressed ? "YES" : "no", text_color = compressed ? color.yellow : color.gray)
    table.cell(info, 0, 2, "Position",   text_color=color.white)
    table.cell(info, 1, 2, pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "FLAT", text_color = pos == 1 ? color.green : pos == -1 ? color.red : color.gray)
    table.cell(info, 0, 3, "Stop $",     text_color=color.white)
    table.cell(info, 1, 3, str.tostring(stopDist, format.mintick), text_color=color.white)
