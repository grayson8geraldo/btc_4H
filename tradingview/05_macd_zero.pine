//@version=6
// ============================================================================
// BTC Tournament Strategy #5 — MACD Zero-Line + EMA50 filter on 4H  *** WINNER ***
// ============================================================================
// Rules (matches backtest/strategies.py : strat_macd_zero):
//   State = LONG  when 4H MACD line > 0 AND 4H close > EMA50
//   State = SHORT when 4H MACD line < 0 AND 4H close < EMA50
//   Otherwise state is preserved.
//   Entry fires on the first 4H bar a state flips.
//   Stop : 3 * ATR14 (15m), no take-profit (ride the trend).
// Honest out-of-sample result (2024-07 -> 2026-03):
//   $200 -> $7,125.10   (+3462.6%)   Max DD -15.8%   Sortino 6.60   PF 8.01
// ----------------------------------------------------------------------------
indicator("BTC Tournament #5 — MACD Zero 4H (WINNER)", overlay=true)

fastLen  = input.int(12, "MACD fast")
slowLen  = input.int(26, "MACD slow")
sigLen   = input.int(9,  "MACD signal")
emaLen   = input.int(50, "EMA filter length")
atrLen   = input.int(14, "ATR length")
atrMult  = input.float(3.0, "Stop = ATR *")

htf = "240"

// Wrapper function so request.security can fetch the full MACD tuple.
// You cannot index ta.macd()[0] — it must be destructured.
f_macd() =>
    [m, s, h] = ta.macd(close, fastLen, slowLen, sigLen)
    [m, s, h]

[macdLine, signalLine, hist] = request.security(syminfo.tickerid, htf, f_macd(), lookahead=barmerge.lookahead_off)
e50 = request.security(syminfo.tickerid, htf, ta.ema(close, emaLen), lookahead=barmerge.lookahead_off)
c4  = request.security(syminfo.tickerid, htf, close,                 lookahead=barmerge.lookahead_off)

longCond  = macdLine > 0 and c4 > e50
shortCond = macdLine < 0 and c4 < e50

var int state = 0
if longCond
    state := 1
else if shortCond
    state := -1

newLong  = state ==  1 and state[1] !=  1
newShort = state == -1 and state[1] != -1
flatten  = state ==  0 and state[1] != 0

a = ta.atr(atrLen)
stopDist = atrMult * a

plot(e50, "EMA 50 (4H)", color=color.blue, linewidth=2)

plotshape(newLong,  "LONG",  shape.labelup,   location.belowbar, color.new(color.green, 0), text="L", textcolor=color.white, size=size.small)
plotshape(newShort, "SHORT", shape.labeldown, location.abovebar, color.new(color.red,   0), text="S", textcolor=color.white, size=size.small)
plotshape(flatten,  "FLAT",  shape.xcross,    location.absolute, color.gray, size=size.tiny)

// Background tint by state
bgcolor(state == 1  ? color.new(color.green, 92) : na)
bgcolor(state == -1 ? color.new(color.red,   92) : na)

alertcondition(newLong,  "BTC #5 MACD Zero LONG",  "LONG: 4H MACD > 0 AND close > EMA50")
alertcondition(newShort, "BTC #5 MACD Zero SHORT", "SHORT: 4H MACD < 0 AND close < EMA50")
alertcondition(flatten,  "BTC #5 MACD Zero FLAT",  "FLAT")

var table info = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Strategy",  text_color=color.white, bgcolor=color.new(color.green, 30))
    table.cell(info, 1, 0, "#5 MACD Zero 4H *WINNER*", text_color=color.white, bgcolor=color.new(color.green, 30))
    table.cell(info, 0, 1, "State",     text_color=color.white)
    table.cell(info, 1, 1, state == 1 ? "LONG" : state == -1 ? "SHORT" : "FLAT", text_color = state == 1 ? color.green : state == -1 ? color.red : color.gray)
    table.cell(info, 0, 2, "MACD (4H)", text_color=color.white)
    table.cell(info, 1, 2, str.tostring(macdLine, "#.##"), text_color=color.white)
    table.cell(info, 0, 3, "Close vs EMA50 (4H)", text_color=color.white)
    table.cell(info, 1, 3, c4 > e50 ? "above" : "below", text_color = c4 > e50 ? color.green : color.red)
    table.cell(info, 0, 4, "Stop $",    text_color=color.white)
    table.cell(info, 1, 4, str.tostring(stopDist, format.mintick), text_color=color.white)
    table.cell(info, 0, 5, "OOS +3462%", text_color=color.white)
    table.cell(info, 1, 5, "DD -15.8%",  text_color=color.white)
