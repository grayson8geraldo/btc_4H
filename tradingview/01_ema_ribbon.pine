//@version=5
// ============================================================================
// BTC Tournament Strategy #1 — EMA Trend Ribbon (9/21/200) on 4H
// ============================================================================
// Signals are derived from the 4-hour timeframe regardless of the chart TF,
// so you can plot the indicator on the 15-minute chart and still react to
// the same signals that the Python backtest used.
//
// Rules (matches backtest/strategies.py : strat_ema_ribbon):
//   Long  when 4H close > EMA200(4H) AND EMA9(4H) > EMA21(4H)
//   Short when 4H close < EMA200(4H) AND EMA9(4H) < EMA21(4H)
//   Flat otherwise
//   Stop distance : 3 * ATR14 on the current (15m) timeframe
// ----------------------------------------------------------------------------
indicator("BTC Tournament #1 — EMA Ribbon 4H", overlay=true, max_labels_count=500)

// --- User-facing inputs (defaults are the same as the honest backtest)
fastLen   = input.int(9,   "EMA Fast")
slowLen   = input.int(21,  "EMA Slow")
trendLen  = input.int(200, "EMA Trend")
atrLen    = input.int(14,  "ATR length")
atrMult   = input.float(3.0, "Stop distance = ATR *")

// --- 4H data pulled with lookahead_off to avoid repainting
htf       = "240"  // 4H
e9   = request.security(syminfo.tickerid, htf, ta.ema(close, fastLen),  lookahead=barmerge.lookahead_off)
e21  = request.security(syminfo.tickerid, htf, ta.ema(close, slowLen),  lookahead=barmerge.lookahead_off)
e200 = request.security(syminfo.tickerid, htf, ta.ema(close, trendLen), lookahead=barmerge.lookahead_off)
c4   = request.security(syminfo.tickerid, htf, close,                   lookahead=barmerge.lookahead_off)

longState  = c4 > e200 and e9 > e21
shortState = c4 < e200 and e9 < e21
state = longState ? 1 : shortState ? -1 : 0

// --- Signals only on the first bar with a new state
newLong  = state ==  1 and state[1] !=  1
newShort = state == -1 and state[1] != -1
flatten  = state ==  0 and state[1] != 0

// --- 15m ATR-based stop
a = ta.atr(atrLen)
stopDist = atrMult * a

// --- Plot ribbons (requested 4H values on the intraday chart)
plot(e9,   "EMA 9 (4H)",   color=color.new(color.yellow, 0))
plot(e21,  "EMA 21 (4H)",  color=color.new(color.orange, 0))
plot(e200, "EMA 200 (4H)", color=color.new(color.blue,   0), linewidth=2)

// --- Signal markers
plotshape(newLong,  "LONG",  shape.labelup,   location.belowbar, color.new(color.green, 0), text="L", textcolor=color.white, size=size.tiny)
plotshape(newShort, "SHORT", shape.labeldown, location.abovebar, color.new(color.red,   0), text="S", textcolor=color.white, size=size.tiny)
plotshape(flatten,  "FLAT",  shape.xcross,    location.absolute, color.new(color.gray, 0), size=size.tiny)

// --- Alerts
alertcondition(newLong,  "BTC #1 EMA Ribbon LONG",  "LONG: 4H EMA 9 > 21 > (close > EMA200)")
alertcondition(newShort, "BTC #1 EMA Ribbon SHORT", "SHORT: 4H EMA 9 < 21 < (close < EMA200)")
alertcondition(flatten,  "BTC #1 EMA Ribbon FLAT",  "FLAT: state cleared")

// --- Info table
var table info = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Strategy",  text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(info, 1, 0, "#1 EMA Ribbon 4H", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(info, 0, 1, "State", text_color=color.white)
    table.cell(info, 1, 1, state == 1 ? "LONG" : state == -1 ? "SHORT" : "FLAT", text_color = state == 1 ? color.green : state == -1 ? color.red : color.gray)
    table.cell(info, 0, 2, "Stop $", text_color=color.white)
    table.cell(info, 1, 2, str.tostring(stopDist, format.mintick), text_color=color.white)
    table.cell(info, 0, 3, "TP", text_color=color.white)
    table.cell(info, 1, 3, "ride the trend", text_color=color.white)
